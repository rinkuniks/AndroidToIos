<?xml version="1.0" encoding="utf-8"?>
<!--
    WA Bridge — Android source app (Phase 2).
    Companion to the official Move to iOS + WhatsApp transfer path.

    Scope locks (see repo README):
    - Vault = accessible WhatsApp media + inventory only, never a full backup.
    - Foreground service required for long transfers (H1).
    - No auto-erase of source (L6).
-->

<!-- The package/applicationId is declared in app/build.gradle.kts (namespace).
     Do not re-add a package= attribute here; AGP 8 ignores it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi peer discovery + multicast (default: Wi-Fi direct / local network) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Prevent the device from sleeping during long transfers (H1/H5) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service for Android 12+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- SAF pick intent -->
    <uses-permission android:name="android.permission.MANAGE_DOCUMENTS" />

    <application
        android:name=".WabridgeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wabridge">

        <!-- Main entry: Welcome -> Direction -> Destination Status -> Connect -> Ready Check -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Wabridge.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for vault scanning + transfer streaming -->
        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync|connectedDevice" />

        <!-- Document provider for SAF (media selection) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
